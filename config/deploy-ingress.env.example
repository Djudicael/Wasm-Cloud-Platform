# wasm-deploy-ingress environment example
#
# Copy to /etc/wasm-cloud/deploy-ingress.env and adjust values for your
# environment. The binary is configured by flags and environment variables.

WASM_DEPLOY_INGRESS_ID=deploy-ingress-0
WASM_DEPLOY_INGRESS_NATS_URL=nats://127.0.0.1:4222
# Optional path to a NATS credentials file.
# WASM_DEPLOY_INGRESS_NATS_CREDS=/etc/wasm-cloud/nats.creds

# Local state and audit paths.
WASM_DEPLOY_INGRESS_DB_PATH=/var/lib/wasm-cloud/deploy-ingress/state.redb
WASM_DEPLOY_INGRESS_AUDIT_PATH=/var/lib/wasm-cloud/deploy-ingress/audit.jsonl

# Listener configuration.
WASM_DEPLOY_INGRESS_BIND_ADDRESS=0.0.0.0
WASM_DEPLOY_INGRESS_PORT=9092
WASM_DEPLOY_INGRESS_ARTIFACT_PORT=9091

# Public URL that nodes should use when fetching artifacts from this ingress.
WASM_DEPLOY_INGRESS_ADVERTISED_ARTIFACT_URL=https://deploy.example.com:9091

# Simple bearer-token auth for the ingress API.
WASM_DEPLOY_INGRESS_AUTH_ENABLED=true
WASM_DEPLOY_INGRESS_AUTH_READ_TOKEN=replace-with-read-token
WASM_DEPLOY_INGRESS_AUTH_WRITE_TOKEN=replace-with-write-token

# Key-encryption-key source for artifact credential storage.
#
# Supported values:
#   generate
#   file
#   env:VAR_NAME
#   passphrase-env:VAR_NAME
#
# Production should use a stable key source, not "generate", otherwise the
# ingress cannot decrypt previously stored artifact credentials after restart.
WASM_DEPLOY_INGRESS_KEY_SOURCE=file
WASM_DEPLOY_INGRESS_KEY_FILE=/etc/wasm-cloud/deploy-ingress.key

# HA coordination.
WASM_DEPLOY_INGRESS_HA_ENABLED=true
WASM_DEPLOY_INGRESS_HA_LEASE_BUCKET=DEPLOY_INGRESS_HA
WASM_DEPLOY_INGRESS_CREDENTIAL_BUCKET=DEPLOY_INGRESS_CREDENTIALS
WASM_DEPLOY_INGRESS_HA_LEASE_TTL_SECS=30
WASM_DEPLOY_INGRESS_HA_LEASE_REFRESH_SECS=10

# Optional signed-artifact policy.
# When enabled, remote deploys must include an Ed25519 signature envelope.
WASM_DEPLOY_INGRESS_REQUIRE_SIGNATURE=false
# Comma-separated allowlists. Empty means unrestricted.
# WASM_DEPLOY_INGRESS_ALLOWED_ISSUERS=https://token.actions.githubusercontent.com
# WASM_DEPLOY_INGRESS_ALLOWED_REPOSITORIES=example-org/hello-api,example-org/payments-api
# WASM_DEPLOY_INGRESS_ALLOWED_NAMESPACES=production,staging

# Optional hardened OCI policy.
# When enabled, refs like oci://registry/org/app:v1 are rejected and callers
# must use digest-pinned refs such as oci://registry/org/app@sha256:...
WASM_DEPLOY_INGRESS_REQUIRE_OCI_DIGEST_REFS=false

# Optional logging override.
# RUST_LOG=deploy_ingress=info,messaging=info,storage=info
