# Reproducible x86_64 guest-kernel compatibility unit for the VM testbed.
# This file is not part of the Wasm Cloud Platform release or a production-host
# kernel policy. Update the values together and rerun the microVM tests.
KERNEL_VERSION=6.18.48
KERNEL_SERIES=6.18
KERNEL_SCHEMA=8
KERNEL_SOURCE_SHA256=5ebdadb10a4b5708fc6b1c457764a110bc49f8150cc3502c59b921ead8c6fc8c

# Firecracker first supports the 6.18 guest-kernel family in v1.16.1.
FIRECRACKER_VERSION=v1.16.1
FIRECRACKER_X86_64_SHA256=382a02a869e4d6d5cb14c40577f9545e8458021ea8b0b2d3fc10ec14d9c242e6
FIRECRACKER_AARCH64_SHA256=8d0e69f6d6f9a1724551f607f18504052c16c1828ee3d4d7b6e6c73380871e0e

# Firecracker's maintained 6.18 x86_64 guest configuration. The build uses
# this as its base, verifies it byte-for-byte, then applies the platform
# overlay. Never replace the commit with a branch name.
FIRECRACKER_CONFIG_COMMIT=a6146c8bb2139ead4ae2470fd15085629d02236e
FIRECRACKER_CONFIG_SHA256=ba22401a0c7292a4c024ebcd10a562d4a1f1bfd2faed671406d3b159c0cf5215
